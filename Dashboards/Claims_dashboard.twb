      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Test Data ' name='federated.0p56yu40hj4tz916iyeg103hv9xu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Threshold' datatype='real' name='[Capital-Loss Parameter]' param-domain-type='range' role='measure' type='quantitative' value='0.20000000000000001'>
              <calculation class='tableau' formula='0.20000000000000001' />
              <range max='0.2' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p56yu40hj4tz916iyeg103hv9xu'>
            <column datatype='integer' name='[Actual]' role='measure' type='quantitative' />
            <column caption='row_number' datatype='integer' name='[Calculation_1104245651861528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='dynamic predicted' datatype='integer' name='[Calculation_1104245652254746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Fraud_Probability] &gt;= [Parameters].[Capital-Loss Parameter] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Ac' datatype='real' name='[Calculation_1104245670989867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actual] + (RANDOM() - 0.5) * 0.1' />
            </column>
            <column caption='colortheme ' datatype='string' name='[Calculation_1104245671215148]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1104245652254746] = 1 then &apos;fraud&apos;&#13;&#10;else &apos;non-fraud&apos;  &#13;&#10;END' />

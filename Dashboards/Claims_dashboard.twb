    <worksheet name='Fraud Probability vs Actual Outcome (Threshold Analysis)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#a68966' fontname='Segoe Fluent Icons'>Fraud Probability vs Actual Outcome</run>

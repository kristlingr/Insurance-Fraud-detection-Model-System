    <worksheet name='Claims Volume &amp; Fraud Rate by Hour of Day'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#a68966' fontname='Segoe Fluent Icons'>Claims Volume &amp; Fraud Rate by Hour of Day</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fraud_dashboard_data' name='federated.0hw4bbs118j0lo19idxwi1yzd5we' />
          </datasources>
          <datasource-dependencies datasource='federated.0hw4bbs118j0lo19idxwi1yzd5we'>
            <column caption='row_count' datatype='integer' name='[Calculation_1104245599281167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Incident hours' datatype='string' name='[Calculation_1104245703536686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([incident_hour_of_the_day]) + &quot;:00&quot;' />
            </column>
            <column caption='total amt claims ' datatype='integer' name='[Calculation_1314802238734338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vehicle_claim] + [injury_claim] + [property_claim]' />
            </column>
            <column caption='Total_claims count' datatype='integer' name='[Calculation_1332943317127177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1104245599281167])' />
            </column>
            <column caption='Fraud rate %' datatype='real' name='[Calculation_1332943319433226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2029208790450176]/[Calculation_1332943317127177]' />
            </column>
            <column caption='Fraud_cases ' datatype='integer' name='[Calculation_2029208790450176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [fraud_reported] = &apos;Y&apos; THEN 1 ELSE 0 END )' />
            </column>
            <column caption='Fraud Reported' datatype='string' name='[fraud_reported]' role='dimension' type='nominal' />
            <column caption='Incident Hour Of The Day' datatype='integer' name='[incident_hour_of_the_day]' role='dimension' type='quantitative' />
            <column caption='Injury Claim' datatype='integer' name='[injury_claim]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1104245703536686]' derivation='None' name='[none:Calculation_1104245703536686:nk]' pivot='key' type='nominal' />
            <column caption='Property Claim' datatype='integer' name='[property_claim]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1314802238734338]' derivation='Sum' name='[sum:Calculation_1314802238734338:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1332943319433226]' derivation='User' name='[usr:Calculation_1332943319433226:qk]' pivot='key' type='quantitative' />
            <column caption='Vehicle Claim' datatype='integer' name='[vehicle_claim]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0hw4bbs118j0lo19idxwi1yzd5we].[sum:Calculation_1314802238734338:qk]' field-type='quantitative' fold='true' scope='rows' type='space' />

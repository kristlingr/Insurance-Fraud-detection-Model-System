    <worksheet name='confusion matrix'>
      <table>
        <view>
          <datasources>
            <datasource caption='fraud_dashboard_data' name='federated.0hw4bbs118j0lo19idxwi1yzd5we' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Threshold' datatype='real' name='[Capital-Loss Parameter]' param-domain-type='range' role='measure' type='quantitative' value='0.20000000000000001'>
              <calculation class='tableau' formula='0.20000000000000001' />
              <range max='0.2' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hw4bbs118j0lo19idxwi1yzd5we'>
            <column datatype='integer' name='[Actual]' role='measure' type='quantitative' />
            <column caption='Predicted(dynamic)' datatype='integer' name='[Calculation_1104245593841664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Fraud_Probability] &gt;= [Parameters].[Capital-Loss Parameter] then 1 else 0 end' />
            </column>
            <column caption='confusion_type' datatype='string' name='[Calculation_1104245594218497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Actual] = 1 AND [Calculation_1104245593841664] = 1 THEN &quot;True Positive&quot;&#13;&#10;ELSEIF [Actual] = 0 AND [Calculation_1104245593841664] = 1 THEN &quot;False Positive&quot;&#13;&#10;ELSEIF [Actual] = 1 AND [Calculation_1104245593841664]= 0 THEN &quot;False Negative&quot;&#13;&#10;ELSE &quot;True Negative&quot;&#13;&#10;END' />
            </column>
            <column caption='True_positive ' datatype='integer' name='[Calculation_1104245594599426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1104245594218497] = &quot;True Positive&quot; THEN 1 END)' />
            </column>
            <column caption='True_negetive' datatype='integer' name='[Calculation_1104245594750979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1104245594218497] = &quot;True Negative&quot; THEN 1 END)' />
            </column>
            <column caption='False positive' datatype='integer' name='[Calculation_1104245595267077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_1104245594218497] = &quot;False Positive&quot; then 1 end)' />
            </column>
            <column caption='row_count' datatype='integer' name='[Calculation_1104245599281167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Actual Label' datatype='string' name='[Calculation_1104245600194577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Actual] = 1 THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
            </column>
            <column caption='Predicted Label' datatype='string' name='[Calculation_1104245600268306]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1104245593841664] = 1 THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
            </column>
            <column caption='cell count' datatype='integer' name='[Calculation_1104245611937812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1104245600194577], [Calculation_1104245600268306] : SUM([Calculation_1104245599281167]) }' />
            </column>
            <column caption='Fraud Probability' datatype='real' name='[Fraud_Probability]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1104245600194577]' derivation='None' name='[none:Calculation_1104245600194577:nk]' pivot='key' type='nominal' />

      <column caption='CM ' datatype='string' name='[Calculation_1104245652443163]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Actual] = 1 AND [Calculation_1104245652254746] = 1 THEN &quot;True Positive&quot;&#13;&#10;ELSEIF [Actual] = 0 AND [Calculation_1104245652254746] = 1 THEN &quot;False Positive&quot;&#13;&#10;ELSEIF [Actual] = 1 AND [Calculation_1104245652254746]= 0 THEN &quot;False Negative&quot;&#13;&#10;ELSE &quot;True Negative&quot;&#13;&#10;END' />
